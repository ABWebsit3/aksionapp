# Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
APP_ID=

# Hub web
PORT=3000
# URL publique à laquelle les joueurs accèdent au hub (sans slash final)
PUBLIC_URL=http://localhost:3000
# Secret pour signer les liens personnels du hub : chaîne longue et aléatoire
# (ex : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
HUB_SECRET=

# Durées (minutes)
CHECKIN_MINUTES=10
QUEUE_TTL_MINUTES=30

# Base de données : MySQL si DB_HOST est défini, sinon SQLite (database.sqlite)
DB_HOST=
DB_PORT=3306
DB=
DB_USER=
DB_PASS=
